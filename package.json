{
  "name": "mms-content-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial, community-made searchable archive of MMS session content, built from public Sched schedules.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "ingest": "tsx scripts/ingest.ts",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run build && npm run smoke && npm test"
  },
  "dependencies": {
    "astro": "^5.1.0",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
